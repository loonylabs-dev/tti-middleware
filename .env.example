# ============================================================
# TTI Middleware Configuration
# ============================================================

# Default TTI Provider (optional)
# Options: google-cloud, edenai, ionos, bfl, azure-foundry
TTI_DEFAULT_PROVIDER=google-cloud

# ============================================================
# Testing
# ============================================================
# Enable integration tests (makes real API calls, costs money)
# TTI_INTEGRATION_TESTS=true

# ============================================================
# Google Cloud (Vertex AI) - RECOMMENDED FOR EU/GDPR
# ============================================================
# DPA: https://cloud.google.com/terms/data-processing-addendum
# Models: imagen-3, imagen-4 (+ fast/ultra), gemini-flash-image, gemini-pro-image

# Project ID (required)
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id

# Service Account JSON file (required)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Region (optional, default: europe-west4)
# EU regions: europe-west1, europe-west4 (recommended), europe-north1
# Note: gemini-flash-image is NOT available in europe-west3 (Frankfurt)!
GOOGLE_CLOUD_REGION=europe-west4

# ============================================================
# Eden AI
# ============================================================
# Aggregator with multiple underlying providers (OpenAI, Stability AI, etc.)

EDENAI_API_KEY=your_edenai_key_here

# ============================================================
# IONOS Cloud
# ============================================================
# German cloud provider with EU data centers

IONOS_API_KEY=your_ionos_key_here
IONOS_API_URL=https://api.ionos.cloud/ai/v1

# ============================================================
# Black Forest Labs (FLUX) - EU DATA RESIDENCY (GDPR)
# ============================================================
# German provider (Freiburg). SOC 2 Type II + ISO 27001.
# Models: flux-1.1-pro, flux-kontext-pro, flux-2-pro
# The default endpoint (api.eu.bfl.ai) keeps inference + delivery within EU.

BFL_API_KEY=your_bfl_key_here
# Endpoint (optional). Default: https://api.eu.bfl.ai (EU/GDPR).
# Do NOT change to api.bfl.ai / api.us.bfl.ai if EU data residency is required.
BFL_API_URL=https://api.eu.bfl.ai

# ============================================================
# Microsoft Foundry (Azure) - FLUX served by Azure
# ============================================================
# FLUX models (FLUX.2 [pro], FLUX.1 Kontext [pro], FLUX1.1 [pro]) via the BFL
# provider-specific API on Microsoft Foundry. EU data residency requires a
# `DataZoneStandard` deployment in an EU region (e.g. germanywestcentral);
# processing is then governed by the Microsoft Products and Services DPA
# (Art. 28) — no sharing with BFL, no training. Synchronous API (no polling).
# Models: flux-2-pro-azure, flux-1.1-pro-azure, flux-kontext-pro-azure, flux-2-flex-azure

# Resource endpoint (required), e.g. https://<resource>.services.ai.azure.com
AZURE_FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com
# Resource key (required), sent as `Authorization: Bearer <key>`.
AZURE_FOUNDRY_API_KEY=your_azure_foundry_key_here
# API version (optional, default: preview).
# AZURE_FOUNDRY_API_VERSION=preview
